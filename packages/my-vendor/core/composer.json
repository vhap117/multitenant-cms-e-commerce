{
    "name": "my-vendor/core",
    "description": "Core foundation handling multi-tenancy, databases, and authentication.",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "spatie/laravel-multitenancy": "*",
        "spatie/laravel-permission": "*"
    },
    "require-dev": {
        "orchestra/testbench": "*",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "VHAP\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VHAP\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VHAP\\Core\\CoreServiceProvider"
            ],
            "aliases": {}
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}